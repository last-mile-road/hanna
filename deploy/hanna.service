[Unit]
Description=HANNA web application
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/srv/hanna
EnvironmentFile=/etc/hanna/hanna.env
ExecStart=/srv/hanna/.venv/bin/uvicorn server.app:app --host 127.0.0.1 --port 8100 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
