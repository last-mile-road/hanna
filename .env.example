# Copy to .env and fill in. .env is gitignored; this file is not.
OPENROUTER_API_KEY=
HF_TOKEN=
GOOGLE_GEOCODING_API_KEY=
DATABASE_URL=postgresql+pg8000://sam@127.0.0.1:55432/hanna_dev
HANNA_IMAGES_DIR=/path/to/test_forms
# Country data outside the repo: ground truth, identifying sidecars
HANNA_COUNTRY_DATA=/path/to/country_data

# Outgoing mail through ZeptoMail's SMTP relay
ZEPTOMAIL_SMTP_HOST=smtp.zeptomail.com
ZEPTOMAIL_SMTP_PORT=465
ZEPTOMAIL_SMTP_USER=emailapikey
ZEPTOMAIL_SMTP_PASSWORD=
ZEPTOMAIL_FROM=support@lastmileroad.org

# The official portal (MoH ID sign-in, no password)
HANNA_FIELD_COOKIE=hanna_field
HANNA_FIELD_SESSION_TTL_DAYS=30
# 1 on any public host: capture endpoints require an identity
HANNA_AUTH_REQUIRED=0
HANNA_COOKIE_SECURE=0
